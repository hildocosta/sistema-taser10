generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


 model Cartucho {
  id               Int       @id @default(autoincrement())
  
  // Dados do Cartucho (alinhados com a planilha)
  item             Int?      // Item/Ordem na planilha
  descricao        String?   @default("CARTUCHO") @db.VarChar(255)
  marca            String?   @default("TASER") @db.VarChar(100)
  modelo           String?   @db.VarChar(100)                      // Ex: OPERACIONAL, TREINAMENTO
  numeroSerie      String    @unique @map("numero_serie") @db.VarChar(100) // Ex: T545015PX
  validade         DateTime?                                       // Ex: 01/2030
  alcance          String?   @db.VarChar(50)                       // Ex: 13,72 Metros
  
  // Status do Ciclo de Vida: "Disponível", "Utilizado", "Vencido", "Danificado"
  status           String    @default("Disponível") @db.VarChar(50)
  
  // Lotação / Localização atual no Batalhão
  subunidade       String?   @default("Reserva de Armas / 17º BPM") @db.VarChar(255)
  
  // Registro de Uso do Cartucho (Boletim & Anexo Drive)
  numeroBoletim    String?   @map("numero_boletim") @db.VarChar(100) // Ex: BOU 2026/123456
  urlBoletim       String?   @map("url_boletim") @db.Text            // Link para o Drive/eProtocolo PMPR
  dataUso          DateTime? @map("data_uso")                       // Data em que foi utilizado/disparado
  
  // Observações Gerais e Auditoria
  observacao       String?   @db.Text
  exclusao         String?   @db.VarChar(10)
  criadoEm         DateTime  @default(now()) @map("criado_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  @@map("cartuchos")
}

model Taser {
  id               Int        @id @default(autoincrement())
  numeroSerie      String     @unique @map("numero_serie") @db.VarChar(100)
  modelo           String     @db.VarChar(100)
  patrimonio       String?    @db.VarChar(255)
  subunidade       String?    @db.VarChar(255)
  status           String?    @default("Disponível") @db.VarChar(100)
  situacao         String?    @default("Operacional") @db.VarChar(100)
  observacao       String?    @db.Text

  criadoEm         DateTime   @default(now()) @map("criado_em")
  atualizadoEm     DateTime   @updatedAt @map("atualizado_em")

  @@map("tasers")
}